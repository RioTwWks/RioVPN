[flake8]
max-line-length = 127
max-complexity = 10
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    .env,
    build,
    dist,
    migrations/versions/*,
    htmlcov,
    .pytest_cache
ignore =
    E203,
    W503,
    F401,
    F811,
    F841,
    F541,
    E711,
    W293,
    E402
per-file-ignores =
    src/models/__init__.py:F401
    src/services/__init__.py:F401
    src/bot/handlers/__init__.py:F401
    tests/conftest.py:F401
count = True
statistics = True
show-source = False

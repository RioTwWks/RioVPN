# Telegram Bot
BOT_TOKEN=

# 3x-ui Panel (RU)
PANEL_3XUI_URL=
PANEL_3XUI_USER=
PANEL_3XUI_PASS=
INBOUND_RU_TAG=
SNI_RU=
PUBLIC_KEY_RU=
SHORT_ID_RU=
SERVER_ADDRESS_RU=
SERVER_PORT_RU=

# Hiddify Panel (EU)
PANEL_HIDDIFY_URL=
PANEL_HIDDIFY_API_KEY=

# Payments
CRYPTOMUS_API_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Admin
ADMIN_TELEGRAM_ID=

# Database (SQLite)
DATABASE_URL=sqlite+aiosqlite:///vpn_bot.db

# Database (PostgreSQL) - Uncomment for production
# DATABASE_URL=postgresql+asyncpg://riovpn:riovpn_secret_password@localhost:5432/riovpn

# Defaults (empty = unlimited)
# DEFAULT_TRAFFIC_LIMIT_RU=10737418240
# DEFAULT_TRAFFIC_LIMIT_EU=21474836480

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO

# Proxy for Telegram connection
# Telegram may be blocked in some regions. Use these settings to route bot traffic through a proxy.
#
# PROXY_MODE options:
#   - 'direct': Direct connection (default, no proxy)
#   - 'socks5': SOCKS5 proxy (e.g., local 3x-ui inbound or v2ray/Hiddify client)
#   - 'http': HTTP proxy
#   - 'ssh_tunnel': SSH tunnel mode (uses SOCKS5 settings; establish tunnel separately)
#
# Usage scenarios:
#   1. Production (server with 3x-ui):
#      - Create local inbound in 3x-ui (SOCKS5, listen 127.0.0.1:10808)
#      - Add routing rule to send traffic through your outbound
#      - Set: PROXY_MODE=socks5, PROXY_URL=socks5://127.0.0.1:10808
#
#   2. Local development with SSH tunnel:
#      - SSH tunnel: ssh -L 10808:127.0.0.1:10808 user@your-server
#      - Set: PROXY_MODE=ssh_tunnel, PROXY_URL=socks5://127.0.0.1:10808
#
#   3. Local development with v2ray/Hiddify client:
#      - Import subscription from your panel
#      - Enable system proxy or note SOCKS5 port (e.g., 10808)
#      - Set: PROXY_MODE=socks5, PROXY_URL=socks5://127.0.0.1:10808
#
PROXY_MODE=direct
PROXY_URL=
PROXY_LOGIN=
PROXY_PASSWORD=
